# Supabase > Project Settings > API Keys. Configura los valores reales en .env.local.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Usa la clave secret (sb_secret_...), nunca una variable NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Opcional: URL real del repositorio público de Stravly.
STRAVLY_GITHUB_URL=
