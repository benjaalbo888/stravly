# Supabase > Project Settings > API Keys. Configura los valores reales en .env.local.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Usa la clave secret (sb_secret_...), nunca una variable NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Opcional: URL de otro repositorio stravly para sustituir el enlace oficial.
STRAVLY_GITHUB_URL=
STRAVLY_MULTI_BUSINESS=0
# Opcional en 2.0. Con 0, /reservar indica dónde encontrar el enlace del negocio.
# El simulador público /demo funciona independientemente de esta variable.
STRAVLY_SHOW_DEMO=1
